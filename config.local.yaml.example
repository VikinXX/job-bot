# ============================================
# CONFIGURACIÓN LOCAL - TUS VALORES REALES
# ============================================
# 1. Copia este archivo desde config.yaml
# 2. Edita SOLO los valores que necesites cambiar
# 3. NO subas este archivo a git (está en .gitignore)

api_keys:
  rapidapi_key: "TU_RAPIDAPI_KEY_AQUI"     # De RapidAPI > JSearch > Security
  groq_key: "gsk_TU_GROQ_KEY_AQUI"         # De console.groq.com/keys

telegram:
  bot_token: "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"  # De @BotFather
  chat_id: "987654321"                            # De getUpdates o @userinfobot

